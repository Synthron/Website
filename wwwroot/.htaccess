# Eigene Fehlerseiten
ErrorDocument 404 /404.html
ErrorDocument 403 "Zugriff verweigert"

# Verzeichnisauflistung deaktivieren
Options -Indexes

# Standarddatei für Verzeichnisaufrufe
DirectoryIndex index.html

# HTML lacks a charset header; send UTF-8 explicitly.
AddDefaultCharset UTF-8

# Production caching. The build appends ?v=<sha256 hash> to every local
# .css/.js/image URL (see README -> Caching and Cache Busting), so versioned
# assets can be cached for one year; the version changes with the file.
# HTML, firmware manifests (.json) and binaries (.bin) are not versioned and
# are revalidated on every request. No Cloudflare cache to purge (DNS only).
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    <FilesMatch "\.(css|js|svg|webp|png|jpg|jpeg|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(json|bin)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Sicherheitsheader
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

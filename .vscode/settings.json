{
  "editor.formatOnSave": false,
  "json.schemas": [
    { "fileMatch": ["/wwwroot/data/projects.json"], "url": "./scripts/schemas/projects.schema.json" },
    { "fileMatch": ["/wwwroot/data/ham.json"], "url": "./scripts/schemas/ham.schema.json" },
    { "fileMatch": ["/wwwroot/data/nav.json", "/wwwroot/data/footer-nav.json"], "url": "./scripts/schemas/nav.schema.json" },
    { "fileMatch": ["/wwwroot/data/pages.json"], "url": "./scripts/schemas/pages.schema.json" }
  ],
  "chat.tools.terminal.autoApprove": {
    "ForEach-Object": true
  },
  // ==========================================
  // File Nesting Configuration
  // ==========================================
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.js": "${capture}.spec.js, ${capture}.test.js, ${capture}.js.map, ${capture}.js.json",
    "package.json": "package-lock.json, .npmrc, .nvmrc, playwright.config.mjs, lighthouserc.json, .htmlvalidate.json, svgo.config.mjs, eslint.config.js, .stylelintrc.json",
    ".gitignore": ".gitattributes, .gitmodules",
    "README.md": "AGENTS.md, todo.md"
  },

}

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "npm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        {
          "owner": "build",
          "pattern": {
            "regexp": "^(.+):(\\d+):(\\d+): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        }
      ]
    },
    {
      "label": "dev",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "dev",
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Dev server: http://localhost:\\d+/ \\(live reload\\)"
          },
          "pattern": {
            "regexp": "^(.+):(\\d+):(\\d+): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        }
      ]
    },
    {
      "label": "serve",
      "type": "shell",
      "command": "npm run serve",
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "serve",
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Serving dist/ at http://localhost:\\d+/"
          },
          "pattern": {
            "regexp": "^(.+):(\\d+):(\\d+): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        }
      ]
    },
    {
      "label": "create project",
      "type": "shell",
      "command": "npm run create -- \"${input:name}\" \"${input:brief}\"",
      "problemMatcher": []
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "npm run clean",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "name",
      "type": "promptString",
      "description": "Project name (used for the title and the page id)"
    },
    {
      "id": "brief",
      "type": "promptString",
      "description": "One-line project brief (used for the summary)"
    }
  ]
}

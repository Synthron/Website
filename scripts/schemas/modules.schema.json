{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "modules.schema.json",
  "title": "wwwroot/data/modules.json",
  "description": "Module pages below a project or ham entry (<lang>/<folder>/<parent page>/<module>.html). See README -> Module Pages.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["parent", "id", "title", "summary", "status", "date", "image"],
    "additionalProperties": false,
    "properties": {
      "parent": {
        "description": "Id of the parent entry in data/projects.json or data/ham.json.",
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "id": {
        "description": "Lowercase, hyphenated, unique per parent; equals the default-language page name <folder>/<parent>/{id}.html.",
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "title": { "$ref": "projects.schema.json#/definitions/localizedText" },
      "summary": { "$ref": "projects.schema.json#/definitions/localizedText" },
      "status": { "$ref": "projects.schema.json#/items/properties/status" },
      "date": { "$ref": "projects.schema.json#/items/properties/date" },
      "image": { "$ref": "projects.schema.json#/items/properties/image" }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projects.schema.json",
  "title": "wwwroot/data/projects.json",
  "description": "Project entries (single source of truth). See README -> Data Model.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "summary", "tags", "status", "date", "links", "image", "featured"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "description": "Lowercase, hyphenated; equals the page name html/proj/{id}.html.",
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "title": { "type": "string", "pattern": "\\S" },
      "summary": { "type": "string", "pattern": "\\S" },
      "tags": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
      },
      "status": {
        "description": "D10: German status values; slugify before using one as a CSS hook.",
        "enum": ["in Arbeit", "fertig", "pausiert", "veraltet", "Konzept", "abgebrochen"]
      },
      "date": {
        "description": "YYYY-MM",
        "type": "string",
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
      },
      "links": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repo": { "$ref": "#/definitions/link" },
          "demo": { "$ref": "#/definitions/link" }
        }
      },
      "image": {
        "description": "Relative path inside wwwroot/ (no ./ or ../ segments, no absolute path).",
        "type": "string",
        "pattern": "^(?![a-zA-Z]:|/)(?!(.*/)?\\.\\.?(/|$))[^\\\\]+$"
      },
      "featured": { "type": "boolean" },
      "draft": {
        "description": "Optional: page is built but hidden from lists, tag filter and sitemap.",
        "type": "boolean"
      }
    }
  },
  "definitions": {
    "link": {
      "description": "null or an http(s) URL.",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^https?://\\S+$" }
      ]
    }
  }
}

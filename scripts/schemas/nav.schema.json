{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nav.schema.json",
  "title": "wwwroot/data/nav.json, wwwroot/data/footer-nav.json",
  "description": "Ordered nav entries per language. href is a relative path or an absolute http(s) URL.",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "$schema": { "type": "string" }
  },
  "patternProperties": {
    "^[a-z]{2,3}$": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "pattern": "\\S" },
          "href": {
            "type": "string",
            "minLength": 1,
            "anyOf": [
              { "pattern": "^https?://" },
              { "not": { "pattern": "^([a-zA-Z][a-zA-Z0-9+.-]*:|/|#)" } }
            ]
          },
          "lang": {
            "description": "Language of the target page when it differs from the nav language (e.g. English footer -> German legal page).",
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          }
        }
      }
    }
  },
  "additionalProperties": false
}

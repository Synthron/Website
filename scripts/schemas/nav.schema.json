{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nav.schema.json",
  "title": "wwwroot/data/nav.json, wwwroot/data/footer-nav.json",
  "description": "Ordered nav entries. href is relative to the web root or an absolute http(s) URL.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["label", "href"],
    "additionalProperties": false,
    "properties": {
      "label": { "type": "string", "pattern": "\\S" },
      "href": {
        "type": "string",
        "minLength": 1,
        "anyOf": [
          { "pattern": "^https?://" },
          { "not": { "pattern": "^([a-zA-Z][a-zA-Z0-9+.-]*:|/|#)" } }
        ]
      }
    }
  }
}
